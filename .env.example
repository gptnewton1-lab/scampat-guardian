# Copy this file to .env and fill in real values.
# NEVER commit the real .env. This file is just a template.

# Base URL of the Watchman FastAPI backend (no trailing slash).
# The code falls back to this local default when the variable is unset.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Lemon Squeezy / Paddle checkout URL for the Premium upgrade.
# When set, the "Upgrade" buttons appear in the header and on upgrade banners,
# and are also used by the daily-limit / premium-feature prompts.
# VITE_CHECKOUT_URL=https://buy.lemonsqueezy.com/your-product